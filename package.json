{
  "name": "notify-tools",
  "version": "0.14.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "CLI, microAuth SDK, connectors, and agent integrations for Notify",
  "repository": "github:Belweave/notify-tools",
  "homepage": "https://notify.belweave.ai/docs",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 tests/cli/*.test.mjs && vitest run --maxWorkers=1",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "release:archive": "node scripts/archive.mjs",
    "test:release": "node --test --test-concurrency=1 tests/release.test.mjs"
  },
  "dependencies": {
    "@opencode-ai/client": "0.0.0-next-16562",
    "@opentunnel/client": "0.5.1",
    "effect": "4.0.2",
    "jose": "6.2.4"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "esbuild": "0.27.7",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
