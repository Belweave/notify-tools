{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "skipLibCheck": true, "esModuleInterop": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["node"],
    "declaration": true, "declarationMap": false, "emitDeclarationOnly": true,
    "outDir": "dist/types", "rootDir": "src"
  },
  "include": ["src/**/*.ts"]
}
